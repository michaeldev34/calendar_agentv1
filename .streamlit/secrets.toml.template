# Google API Credentials Template
# Copy this file to secrets.toml and replace with your actual credentials

CLIENT_ID = "your-google-client-id-here.apps.googleusercontent.com"
CLIENT_SECRET = "your-google-client-secret-here"
REDIRECT_URI = "http://localhost:8501"

# Instructions to get these credentials:
# 1. Go to https://console.cloud.google.com/
# 2. Create a new project or select an existing one
# 3. Enable Google Calendar API and Google Tasks API
# 4. Go to "Credentials" in the left sidebar
# 5. Click "Create Credentials" > "OAuth 2.0 Client IDs"
# 6. Choose "Web application"
# 7. Add "http://localhost:8501" to "Authorized redirect URIs"
# 8. Copy the Client ID and Client Secret here
# 9. Save this file as secrets.toml (without .template extension)
